{
  "icon": {
    "image": "brand/icon.png"
  },
  "name": "Questora",
  "secrets": [
    {
      "key": "ADMIN_USERNAMES",
      "description": "Comma-separated Homeroom usernames that get admin access to Questora",
      "required": true,
      "private": true,
      "staging_default": "staging-demo-admin"
    },
    {
      "key": "EVM_RPC_CREDENTIALS",
      "description": "JSON map of credential name to header additions for RPC endpoints that need auth (e.g. {\"alchemy\": {\"headers\": {\"Authorization\": \"Bearer ...\"}}}). Optional; endpoints without auth need nothing.",
      "required": false,
      "private": true,
      "staging_default": {}
    }
  ],
  "tests": [
    {
      "name": "Discovery homepage renders",
      "path": "/",
      "expectSelector": "h1",
      "expectText": "Explore"
    },
    {
      "name": "Discover lists a seeded campaign after project dedupe",
      "path": "/",
      "expectSelector": "a[href=\"/campaigns/staging-demo-welcome-campaign\"]",
      "expectText": "Staging demo Welcome Campaign"
    },
    {
      "name": "Hierarchical campaign page checklist",
      "path": "/projects/staging-demo-octra-builders/campaigns/staging-demo-welcome-campaign",
      "expectText": "Quests"
    },
    {
      "name": "Seeded profile renders",
      "path": "/u/staging-demo-user-1",
      "expectText": "Staging demo user 1"
    },
    {
      "name": "Create wizard opens",
      "path": "/create",
      "expectText": "Project"
    },
    {
      "name": "Public credential page renders",
      "path": "/credentials/00000000-0000-4000-8000-000000000001",
      "expectText": "Staging demo Welcome Credential"
    },
    {
      "name": "Search finds seeded content",
      "path": "/search?q=welcome",
      "expectText": "Staging demo Welcome Campaign"
    },
    {
      "name": "Join page accepts an invite code",
      "path": "/join?ref=demo-ref-2",
      "expectText": "staging-demo-user-2"
    },
    {
      "name": "Project leaderboard renders",
      "path": "/projects/staging-demo-octra-builders/leaderboard",
      "expectText": "staging-demo-user-1"
    },
    {
      "name": "Profile credentials tab renders",
      "path": "/u/staging-demo-user-1?tab=credentials",
      "expectText": "Staging demo Welcome Credential"
    },
    {
      "name": "Profile reputation panel renders",
      "path": "/u/staging-demo-user-1?tab=reputation",
      "expectText": "Quests completed"
    },
    {
      "name": "Profile achievements tab renders",
      "path": "/u/staging-demo-user-1?tab=achievements",
      "expectText": "First Quest"
    },
    {
      "id": "campaign.checklist",
      "name": "Campaign checklist flow",
      "path": "/projects/staging-demo-octra-builders/campaigns/staging-demo-welcome-campaign",
      "expectSelector": ".quest-list",
      "visual": true,
      "impact": [
        "public/**",
        "src/**"
      ]
    },
    {
      "id": "credential.public-page",
      "name": "Public credential page",
      "path": "/credentials/00000000-0000-4000-8000-000000000001",
      "expectText": "Staging demo Welcome Credential",
      "visual": true,
      "impact": [
        "public/**",
        "src/routes/credentials.js"
      ]
    },
    {
      "id": "search.results",
      "name": "Search results",
      "path": "/search?q=welcome",
      "expectText": "Staging demo Welcome Campaign",
      "visual": true,
      "impact": [
        "public/views.js",
        "src/routes/misc.js"
      ]
    },
    {
      "id": "referral.join",
      "name": "Join via invite link",
      "path": "/join?ref=demo-ref-2",
      "expectText": "staging-demo-user-2",
      "visual": true,
      "impact": [
        "public/views.js",
        "src/referrals.js",
        "src/routes/referrals.js"
      ]
    },
    {
      "name": "Projects directory renders",
      "path": "/projects",
      "expectText": "Projects"
    },
    {
      "name": "Project overview renders",
      "path": "/projects/staging-demo-octra-builders",
      "expectText": "Staging demo Octra Builders"
    },
    {
      "name": "Campaign leaderboard renders",
      "path": "/projects/staging-demo-octra-builders/campaigns/staging-demo-welcome-campaign/leaderboard",
      "expectText": "staging-demo-user-1"
    },
    {
      "name": "Quest leaderboard renders",
      "path": "/projects/staging-demo-octra-builders/campaigns/staging-demo-welcome-campaign/quests/complete-quiz/leaderboard",
      "expectText": "staging-demo-user-1"
    },
    {
      "name": "Dashboard blocks a non-member",
      "path": "/dashboard/projects/staging-demo-octra-builders",
      "expectText": "access"
    },
    {
      "name": "Dashboard explains project roles",
      "path": "/dashboard/projects/staging-demo-octra-builders",
      "expectText": "moderator role",
      "id": "project.access-gating",
      "visual": true,
      "impact": [
        "public/**",
        "src/**"
      ]
    },
    {
      "name": "Project settings route resolves",
      "path": "/dashboard/projects/staging-demo-octra-builders/settings",
      "expectText": "access"
    },
    {
      "name": "Profile projects tab renders",
      "path": "/u/staging-demo-user-1?tab=projects",
      "expectText": "Staging demo Octra Builders"
    },
    {
      "name": "Project quests directory renders",
      "path": "/projects/staging-demo-octra-builders/quests",
      "expectText": "Quests in Staging demo Octra Builders"
    },
    {
      "id": "quests.status-vocabulary",
      "name": "Project quests directory uses the simplified status wording",
      "path": "/projects/staging-demo-octra-builders/quests",
      "expectSelector": "a[href*='/quests/']",
      "expectText": "Published",
      "visual": true,
      "impact": [
        "public/views.js",
        "public/quest-builder.js"
      ]
    },
    {
      "id": "quests.manager",
      "name": "Quests manager lists quests with the simplified filters",
      "path": "/dashboard/projects/staging-demo-octra-builders/quests?demo=1",
      "expectSelector": "a[href$='/quests/new']",
      "expectText": "Create Quest",
      "visual": true,
      "impact": [
        "public/views.js",
        "public/quest-builder.js",
        "src/routes/creator.js"
      ]
    },
    {
      "name": "Create Quest form opens from the Quests manager",
      "path": "/dashboard/projects/staging-demo-octra-builders/quests/new?demo=1",
      "expectText": "Quest details"
    },
    {
      "id": "manage.projects",
      "name": "Manage lists the project with an inline edit and a delete",
      "path": "/dashboard/projects/staging-demo-octra-builders/manage?demo=1",
      "expectSelector": "button[aria-current='page']",
      "expectText": "Staging demo Octra Builders",
      "visual": true,
      "impact": [
        "public/views.js"
      ]
    },
    {
      "name": "Manage campaign tab lists a seeded campaign",
      "path": "/dashboard/projects/staging-demo-octra-builders/manage?tab=campaigns&demo=1",
      "expectText": "Staging demo Welcome Campaign"
    },
    {
      "name": "Manage quest tab lists a seeded quest",
      "path": "/dashboard/projects/staging-demo-octra-builders/manage?tab=quests&demo=1",
      "expectText": "Connect Wallet"
    },
    {
      "id": "wallets.panel",
      "name": "Profile Wallets tab lists a linked wallet",
      "path": "/u/staging-demo-user-1?tab=wallets",
      "expectText": "Verified",
      "visual": true,
      "impact": [
        "public/views.js",
        "public/wallets.js",
        "src/routes/wallets.js",
        "src/seed.js"
      ]
    },
    {
      "name": "Header account menu lists the profile destinations",
      "path": "/?menu=account",
      "expectText": "Account Settings",
      "id": "nav.account-menu",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/app.js"
      ]
    },
    {
      "name": "Wallet chain picker is reachable",
      "path": "/me?tab=wallets",
      "expectText": "Wallets"
    },
    {
      "name": "Wallets tab shows the per-network address manager",
      "path": "/me?tab=wallets",
      "expectSelector": ".wallet-manager",
      "expectText": "Link up to 3 addresses on each network"
    },
    {
      "name": "Participant on-chain quest shows the Verify button",
      "path": "/quests/staging-demo-hold-sepolia-eth",
      "expectText": "Verify"
    },
    {
      "id": "project.access-overview",
      "name": "Project overview reaches the dashboard",
      "path": "/projects/staging-demo-octra-builders",
      "expectText": "Staging demo Octra Builders",
      "visual": true,
      "impact": [
        "public/**",
        "src/**"
      ]
    },
    {
      "id": "nav.theme-menu",
      "name": "Theme menu offers Light, Dark and System",
      "path": "/?menu=theme",
      "expectText": "System",
      "visual": true,
      "impact": [
        "public/**"
      ]
    },
    {
      "id": "nav.notifications-panel",
      "name": "Notification panel opens from the header bell",
      "path": "/?menu=notifications",
      "expectText": "View all",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/app.js",
        "src/routes/misc.js"
      ]
    },
    {
      "id": "nav.mobile-drawer",
      "name": "Mobile navigation drawer opens from the hamburger",
      "path": "/?menu=mobile",
      "expectSelector": "[data-drawer] button[aria-label=\"Close navigation\"]",
      "expectText": "Connected Wallets",
      "visual": true,
      "impact": [
        "public/**"
      ]
    },
    {
      "id": "nav.bottom-bar",
      "name": "Mobile bottom navigation shows the four destinations",
      "path": "/",
      "expectSelector": "#bottom-nav a[href=\"/campaigns\"]",
      "expectText": "Campaigns",
      "visual": true,
      "impact": [
        "public/**"
      ]
    },
    {
      "id": "nav.create-menu",
      "name": "Create menu offers Project to a visitor with no project",
      "path": "/?menu=create",
      "expectText": "Project",
      "visual": true,
      "impact": [
        "public/app.js"
      ]
    },
    {
      "name": "Account settings page renders",
      "path": "/settings",
      "expectText": "Account Settings"
    },
    {
      "name": "My projects page renders an empty state",
      "path": "/my-projects",
      "expectText": "My Projects"
    },
    {
      "name": "Unknown paths show the not-found view",
      "path": "/definitely-not-a-page",
      "expectText": "Page not found"
    },
    {
      "name": "Legacy flat campaign link still resolves",
      "path": "/campaigns/staging-demo-welcome-campaign",
      "expectText": "Quests"
    },
    {
      "name": "Legacy project alias still resolves",
      "path": "/p/staging-demo-octra-builders",
      "expectText": "Staging demo Octra Builders"
    },
    {
      "name": "Header offers Connect wallet",
      "path": "/",
      "expectText": "Connect wallet"
    }
  ],
  "visibility": {
    "build": "private",
    "view": "public"
  }
}
